[Unit]
Description=ydotoold - virtual input daemon (for tiny-dictate paste)
After=graphical-session.target

[Service]
# The write ACL on /dev/uinput is granted by logind when the session becomes
# active, which can land after this unit starts: wait for it instead of
# crashing on "failed to open uinput device".
ExecStartPre=/bin/sh -c 'for i in $(seq 1 150); do [ -w /dev/uinput ] && exit 0; sleep 0.2; done'
ExecStart=/usr/bin/ydotoold
Restart=on-failure
RestartSec=1

[Install]
WantedBy=default.target
