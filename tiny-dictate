#!/usr/bin/env bash

STATE_DIR="${XDG_RUNTIME_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}}/tiny-dictate"
# One directory per dictation. It *is* the claim on the microphone: creating it
# with mkdir is atomic, so two dictations can never run at once.
SESSION_DIR="$STATE_DIR/session"
SESSION_PIDFILE="$SESSION_DIR/session.pid"
RECORDER_PIDFILE="$SESSION_DIR/arecord.pid"
ENCODER_PIDFILE="$SESSION_DIR/lame.pid"
SPINNER_PIDFILE="$SESSION_DIR/spinner.pid"
SPINNER_STOP_FILE="$SESSION_DIR/spinner.stop"
AUDIO_FILE="$SESSION_DIR/audio.mp3"
AUDIO_FIFO="$SESSION_DIR/audio.fifo"
AUDIO_ERROR_FILE="$SESSION_DIR/arecord.err"
TRANSCRIBE_ERROR_FILE="$SESSION_DIR/transcribe.err"
NOTIFY_IDFILE="$STATE_DIR/notification.id"
COMMAND_LOCK_DIR="$STATE_DIR/command.lock"

mkdir -p "$STATE_DIR"

require_commands() {
    local missing=()
    local cmd

    for cmd in "$@"; do
        if ! command -v "$cmd" >/dev/null 2>&1; then
            missing+=("$cmd")
        fi
    done

    if [ "${#missing[@]}" -gt 0 ]; then
        printf 'Missing dependencies: %s\n' "${missing[*]}" >&2
        return 1
    fi
}

format_error_message() {
    local error_text="$1"
    local single_line

    single_line="$(printf '%s' "$error_text" | tr '\n' ' ' | sed -E 's/[[:space:]]+/ /g; s/^ //; s/ $//')"
    if [ -z "$single_line" ]; then
        printf 'Unknown error'
        return
    fi

    printf '%.180s' "$single_line"
}

notify_init() {
    NOTIFY_APP_NAME="$1"
    NOTIFY_IDFILE="$2"
}

notify_message() {
    local message="$1"
    local timeout="${2:-0}"
    local urgency="${3:-normal}"
    local args=(--printid --appname "$NOTIFY_APP_NAME" --urgency "$urgency" --timeout "$timeout")
    local notify_id

    if [ -f "$NOTIFY_IDFILE" ]; then
        args+=(--replace "$(cat "$NOTIFY_IDFILE")")
    fi

    notify_id="$(dunstify "${args[@]}" "$NOTIFY_APP_NAME" "$message")" || return 1
    printf '%s' "$notify_id" > "$NOTIFY_IDFILE"
}

close_notification() {
    if [ -f "$NOTIFY_IDFILE" ]; then
        dunstify --close="$(cat "$NOTIFY_IDFILE")" >/dev/null 2>&1 || true
        rm -f "$NOTIFY_IDFILE"
    fi
}

# The spinner is the only writer of the notification while it runs. It is never
# killed: whoever wants to write the notification asks it to stop and waits for it,
# so no dunstify call of the spinner can land after the notification was replaced.
spinner_loop() {
    local label="$1"
    local owner_pid="$2"

    # This runs in a subshell: do not inherit the caller's EXIT trap.
    trap - EXIT

    local frames=('⠋' '⠙' '⠹' '⠸' '⠼' '⠴' '⠦' '⠧' '⠇' '⠏')
    local i=0

    while [ ! -e "$SPINNER_STOP_FILE" ] && kill -0 "$owner_pid" 2>/dev/null; do
        notify_message "$label ${frames[$i]}" || true
        i=$(( (i + 1) % ${#frames[@]} ))
        sleep 0.15
    done

    # The owner died without asking us to stop: nobody else will clean up, so close
    # the notification ourselves instead of leaving it frozen on screen.
    if [ ! -e "$SPINNER_STOP_FILE" ]; then
        close_notification
    fi
}

start_spinner() {
    local label="$1"
    local owner_pid="$2"

    rm -f "$SPINNER_STOP_FILE"
    spinner_loop "$label" "$owner_pid" &
    SPINNER_PID=$!
    printf '%s' "$SPINNER_PID" > "$SPINNER_PIDFILE"
}

# Ask the spinner to stop and wait for it to be gone. Once this returns, no frame
# of the spinner is in flight and the caller may safely write the notification.
stop_spinner() {
    local pid="${SPINNER_PID:-}"
    local i

    if [ -z "$pid" ] && [ -f "$SPINNER_PIDFILE" ]; then
        pid="$(cat "$SPINNER_PIDFILE" 2>/dev/null)"
    fi
    [ -z "$pid" ] && return 0

    if kill -0 "$pid" 2>/dev/null; then
        # The spinner exits when it sees the stop file, or when its owner dies. If the
        # session directory is already gone (we are being torn down) it cannot see the
        # file: kill it instead of waiting forever for it.
        if ! touch "$SPINNER_STOP_FILE" 2>/dev/null; then
            kill "$pid" 2>/dev/null || true
        fi

        # Bounded wait: a spinner is gone once kill -0 fails, and it is alive while any
        # dunstify call of it is in flight.
        for i in {1..40}; do
            kill -0 "$pid" 2>/dev/null || break
            sleep 0.05
        done
    fi

    SPINNER_PID=""
    rm -f "$SPINNER_PIDFILE" 2>/dev/null
}

detect_clipboard_tool() {
    if command -v wl-copy >/dev/null 2>&1 && command -v wl-paste >/dev/null 2>&1; then
        CLIPBOARD_TOOL="wl-clipboard"
        return 0
    fi
    return 1
}

clipboard_write_clipboard() {
    local value="$1"
    printf '%s' "$value" | wl-copy
}

clipboard_write_primary() {
    local value="$1"
    printf '%s' "$value" | wl-copy --primary
}

clipboard_write_both() {
    local value="$1"
    clipboard_write_clipboard "$value"
    clipboard_write_primary "$value"
}

clipboard_paste_via_shift_insert() {
    local value="$1"
    local hold_delay="${LLM_SHIFT_INSERT_HOLD_DELAY_SEC:-0.04}"
    local key_status=0

    clipboard_write_both "$value"

    # ydotool uses Linux input keycodes: 42=LeftShift, 110=Insert.
    ydotool key 42:1 || return 1
    sleep "$hold_delay"
    ydotool key 110:1 110:0 || key_status=$?
    sleep "$hold_delay"
    ydotool key 42:0 || true

    return "$key_status"
}

notify_init "tiny-dictate" "$NOTIFY_IDFILE"

release_command_lock() {
    rm -rf "$COMMAND_LOCK_DIR"
}

acquire_command_lock() {
    local owner_pid

    if mkdir "$COMMAND_LOCK_DIR" 2>/dev/null; then
        printf '%s' "$$" > "$COMMAND_LOCK_DIR/pid"
        trap release_command_lock EXIT
        return 0
    fi

    if [ -f "$COMMAND_LOCK_DIR/pid" ]; then
        owner_pid="$(cat "$COMMAND_LOCK_DIR/pid" 2>/dev/null || true)"
        if [ -n "$owner_pid" ] && ! kill -0 "$owner_pid" 2>/dev/null; then
            rm -rf "$COMMAND_LOCK_DIR"
            if mkdir "$COMMAND_LOCK_DIR" 2>/dev/null; then
                printf '%s' "$$" > "$COMMAND_LOCK_DIR/pid"
                trap release_command_lock EXIT
                return 0
            fi
        fi
    fi

    return 1
}

# Query only: nothing is modified here, so a query cannot perturb a live session.
is_running_pidfile() {
    local pid

    pid="$(cat "$1" 2>/dev/null)" || return 1
    [ -n "$pid" ] || return 1
    kill -0 "$pid" 2>/dev/null
}

recording_active() {
    is_running_pidfile "$RECORDER_PIDFILE"
}

session_active() {
    is_running_pidfile "$SESSION_PIDFILE"
}

# Send a signal to the process recorded in a pidfile. The pidfile is deliberately NOT
# removed: the session uses it to tell whether the recorder is still alive, so deleting
# it here would make the session believe that recording is over.
kill_from_pidfile() {
    local pidfile="$1"
    local signal="$2"

    if is_running_pidfile "$pidfile"; then
        kill "$signal" "$(cat "$pidfile")" 2>/dev/null
    fi
}

# Create the session directory. mkdir is the atomic claim: it fails when a session
# already exists, whether it is live or stale.
claim_session() {
    mkdir "$SESSION_DIR" 2>/dev/null && return 0

    # A stale directory (session killed by a signal, crash…) can be reclaimed, but
    # never while a session or a recorder process is still alive.
    if session_active || recording_active; then
        return 1
    fi

    rm -rf "$SESSION_DIR"
    mkdir "$SESSION_DIR" 2>/dev/null
}

microphone_is_muted() {
    local output
    local control

    if command -v wpctl >/dev/null 2>&1; then
        output="$(wpctl get-volume @DEFAULT_AUDIO_SOURCE@ 2>/dev/null || true)"
        if [ -n "$output" ]; then
            printf '%s' "$output" | grep -q '\[MUTED\]' && return 0
            return 1
        fi
    fi

    if command -v pactl >/dev/null 2>&1; then
        output="$(pactl get-source-mute @DEFAULT_SOURCE@ 2>/dev/null || true)"
        case "$output" in
            *"Mute: yes"*) return 0 ;;
            *"Mute: no"*) return 1 ;;
        esac
    fi

    if command -v amixer >/dev/null 2>&1; then
        for control in Capture Mic; do
            output="$(amixer -D default sget "$control" 2>/dev/null || true)"
            if [ -n "$output" ]; then
                printf '%s' "$output" | grep -q '\[on\]' && return 1
                printf '%s' "$output" | grep -q '\[off\]' && return 0
            fi
        done
    fi

    return 1
}

ensure_micro_not_muted() {
    if microphone_is_muted; then
        notify_message "🎙️ Microphone is muted. Unmute it before dictating." 4500 critical || true
        return 1
    fi

    return 0
}

# The session process owns the whole dictation lifecycle: it outlives the `start`
# command that forked it and it is the only process driving the progress spinner.
session() {
    local transcript
    local error_message
    local recording_failed=0
    local encoder_failed=0
    local had_error=0

    # This runs in a subshell: do not inherit the caller's EXIT trap.
    trap - EXIT
    trap session_cleanup EXIT

    # $BASHPID, not $$: inside a subshell $$ still expands to the pid of the
    # `tiny-dictate start` process, which exits right after forking us.
    start_spinner "🎤 Recording" "$BASHPID"

    # Wait for the recorder, which our parent started and recorded before forking us.
    # If the encoder dies first, the recorder writes into a pipe nobody reads and
    # would block forever: give up instead of spinning forever.
    while is_running_pidfile "$RECORDER_PIDFILE"; do
        if ! is_running_pidfile "$ENCODER_PIDFILE"; then
            recording_failed=1
            break
        fi
        sleep 0.1
    done

    # The encoder exits once the recorder is gone and it has flushed its last frames.
    # Bounded: lame blocks in open() until arecord opens the pipe, so never wait for
    # it forever.
    for _ in {1..100}; do
        is_running_pidfile "$ENCODER_PIDFILE" || break
        sleep 0.05
    done

    if is_running_pidfile "$ENCODER_PIDFILE"; then
        recording_failed=1
        encoder_failed=1
    fi

    [ -s "$AUDIO_FILE" ] || recording_failed=1

    stop_spinner

    if [ "$recording_failed" -eq 1 ]; then
        kill_from_pidfile "$RECORDER_PIDFILE" -INT
        kill_from_pidfile "$ENCODER_PIDFILE" -TERM
        if [ "$encoder_failed" -eq 1 ]; then
            error_message="the audio encoder did not finish"
        else
            error_message="$(format_error_message "$(cat "$AUDIO_ERROR_FILE" 2>/dev/null)")"
        fi
        notify_message "❌ Recording failed: $error_message" 6000 || true
        return 0
    fi

    start_spinner "⏳ Transcribing" "$BASHPID"

    if transcript="$(llm groq-whisper - < "$AUDIO_FILE" 2>"$TRANSCRIBE_ERROR_FILE")"; then
        if [ -n "$transcript" ]; then
            if ! clipboard_paste_via_shift_insert "$transcript"; then
                notify_message "❌ Could not paste the transcription" 6000 critical || true
            fi
        fi
    else
        had_error=1
        stop_spinner
        error_message="$(format_error_message "$(cat "$TRANSCRIBE_ERROR_FILE" 2>/dev/null)")"
        notify_message "❌ Transcription failed: $error_message" 6000 || true
    fi

    stop_spinner
    if [ "$had_error" -eq 0 ]; then
        close_notification
    fi
}

session_cleanup() {
    stop_spinner
    rm -rf "$SESSION_DIR"
}

start() {
    local recorder_pid
    local encoder_pid

    if ! claim_session; then
        # A session is running: its spinner already shows what is going on, and it must
        # stay the only writer of the notification.
        printf 'tiny-dictate is already busy\n' >&2
        return 1
    fi

    if ! ensure_micro_not_muted; then
        rm -rf "$SESSION_DIR"
        return 1
    fi

    if ! mkfifo "$AUDIO_FIFO"; then
        rm -rf "$SESSION_DIR"
        notify_message "❌ Cannot create the audio pipe" 6000 || true
        return 1
    fi

    # lame opens the pipe for reading, arecord for writing. Both PIDs are recorded
    # here, synchronously, *before* the session process is forked: that is what makes
    # the wait in `session` race-free.
    lame -r -s 16 --bitwidth 16 --signed --little-endian -m m -b 64 -S - "$AUDIO_FILE" \
        < "$AUDIO_FIFO" &
    encoder_pid=$!
    printf '%s' "$encoder_pid" > "$ENCODER_PIDFILE"

    arecord -f S16_LE -r 16000 -c 1 -t raw > "$AUDIO_FIFO" 2>"$AUDIO_ERROR_FILE" &
    recorder_pid=$!
    printf '%s' "$recorder_pid" > "$RECORDER_PIDFILE"

    session &
    printf '%s' "$!" > "$SESSION_PIDFILE"
}

stop() {
    if recording_active; then
        kill_from_pidfile "$RECORDER_PIDFILE" -INT
    elif session_active; then
        # No notification here: the session spinner already shows "Transcribing" and
        # must stay the only writer of the notification.
        printf 'Transcription already in progress\n' >&2
    fi
}

cancel() {
    if ! recording_active && ! session_active; then
        echo "No recording in progress"
        return 0
    fi

    # Kill the session first: once it is gone no new spinner can appear, so the one
    # stopped below is the last writer of the notification.
    kill_from_pidfile "$SESSION_PIDFILE" -TERM
    kill_from_pidfile "$RECORDER_PIDFILE" -INT
    kill_from_pidfile "$ENCODER_PIDFILE" -TERM
    stop_spinner
    rm -rf "$SESSION_DIR"
    # The 1s timeout dismisses this notification. Do not keep a detached process that
    # would close it later: it would be a second writer of the notification, and a
    # dictation started in the meantime would lose its own notification.
    notify_message "🛑 Recording cancelled" 1000
}

toggle() {
    if recording_active; then
        stop
    elif session_active; then
        printf 'Transcription already in progress\n' >&2
    else
        start
    fi
}

status() {
    if recording_active || session_active; then
        echo "working"
    else
        echo "idle"
    fi
}

usage() {
    cat <<'EOF'
Usage: tiny-dictate <command>

Commands:
  start   Start recording
  stop    Stop recording and transcribe
  cancel  Cancel recording
  toggle  Start if idle, stop if recording
  status  Show status (idle or working)
EOF
}

if ! require_commands arecord lame llm ydotool dunstify; then
    dunstify --appname "tiny-dictate" --timeout 6000 "tiny-dictate" "❌ Missing dependencies" >/dev/null 2>&1 || true
    printf 'Install the missing commands and retry.\n' >&2
    exit 1
fi

if ! detect_clipboard_tool; then
    printf 'Missing dependencies: wl-copy and wl-paste\n' >&2
    dunstify --appname "tiny-dictate" --timeout 6000 "tiny-dictate" "❌ Missing dependencies: wl-copy and wl-paste" >/dev/null 2>&1 || true
    printf 'Install wl-clipboard and retry.\n' >&2
    exit 1
fi

command=""

while [ "$#" -gt 0 ]; do
    case "$1" in
        start|stop|cancel|toggle|status)
            if [ -n "$command" ]; then
                echo "Only one command can be provided" >&2
                exit 1
            fi
            command="$1"
            ;;
        -h|--help|help)
            command="help"
            ;;
        *)
            echo "Unknown argument: $1" >&2
            usage
            exit 1
            ;;
    esac
    shift
done

case "$command" in
    start|stop|cancel|toggle)
        if ! acquire_command_lock; then
            notify_message "⏳ tiny-dictate is already handling another command" 1200 || true
            exit 1
        fi
        ;;
esac

case "$command" in
    start)
        start
        ;;
    stop)
        stop
        ;;
    cancel)
        cancel
        ;;
    toggle)
        toggle
        ;;
    status)
        status
        ;;
    ""|help)
        usage
        ;;
    *)
        usage
        exit 1
        ;;
esac
