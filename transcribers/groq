#!/usr/bin/env bash
#
# Reference tiny-dictate transcription plugin: Groq Whisper.
#
# Contract (see the Transcribers section of README.md):
#   $1      path to the recorded audio file
#   $2      session directory; when given, the provider's own answer is also left there as
#           transcript.raw.json, verbatim
#   stdout  the transcribed text
#   exit 0  on success; any other status means failure and stderr is shown to the user
#
# The probe `--print-audio-limit` prints the largest audio file this transcriber accepts, in
# bytes, and exits 0. Anything else on the command line is an audio file to transcribe.
#
# This is the transcriber shipped with the tool: install it as `tiny-dictate-transcribe` on PATH,
# or point TINY_DICTATE_TRANSCRIBE at it. Copy it, or wrap it to fetch the key from wherever you
# keep it:
#
#   GROQ_API_KEY="$(my-key-helper 'Groq API key')" exec transcribers/groq "$@"
#
#   GROQ_API_KEY       required
#   GROQ_WHISPER_MODEL defaults to whisper-large-v3 (whisper-large-v3-turbo is faster
#                      and cheaper)
#   GROQ_LANGUAGE      ISO-639-1 code of the spoken language (e.g. fr), improves accuracy
#                      and latency
#   GROQ_PROMPT        short hint that biases the decoder towards the spelling of words it
#                      would otherwise guess wrong; the API caps it at 224 tokens, and
#                      Whisper sometimes echoes it instead of transcribing, so keep it to a
#                      handful of words. GROQ_PROMPT_FILE reads it from a file.
#   GROQ_RESPONSE_FORMAT
#                      text (default) or verbose_json, which reports no_speech_prob per
#                      segment: the reliable way to drop what Whisper invents on non-speech
#                      audio, since a room's noise peaks as loud as speech.
#
# For a deterministic fix of what it mishears, rewrite the transcript afterwards: it is plain
# text, and a wrapper does that in three lines.

set -euo pipefail

API_URL="https://api.groq.com/openai/v1/audio/transcriptions"

# Groq's free tier rejects uploads above 25 MB, so that is what the tool can dictate to: the
# recording stops by itself at the duration 25_000_000 bytes buys at 64 kbit/s, around 52 min.
if [ "${1:-}" = "--print-audio-limit" ]; then
    printf '25000000\n'
    exit 0
fi

audio_file="${1:-}"
session_dir="${2:-}"

if [ -z "$audio_file" ]; then
    printf 'usage: %s <audio file> [session directory]\n' "${0##*/}" >&2
    exit 2
fi

if [ ! -s "$audio_file" ]; then
    printf 'audio file is missing or empty: %s\n' "$audio_file" >&2
    exit 1
fi

if [ -z "${GROQ_API_KEY:-}" ]; then
    printf 'GROQ_API_KEY is not set (create one at https://console.groq.com/keys)\n' >&2
    exit 1
fi

prompt="${GROQ_PROMPT:-}"
if [ -z "$prompt" ] && [ -s "${GROQ_PROMPT_FILE:-}" ]; then
    prompt="$(cat "$GROQ_PROMPT_FILE")"
fi

form=(--form "file=@$audio_file")
# --form-string, so that a prompt starting with @ or < is not read as a filename
form+=(--form-string "model=${GROQ_WHISPER_MODEL:-whisper-large-v3}")
form+=(--form-string "response_format=${GROQ_RESPONSE_FORMAT:-text}")
if [ -n "${GROQ_LANGUAGE:-}" ]; then
    form+=(--form-string "language=$GROQ_LANGUAGE")
fi
if [ -n "$prompt" ]; then
    form+=(--form-string "prompt=$prompt")
fi

# The provider's answer is the transcript, and the very same bytes are what a given `$2` keeps as
# the raw answer. `--output` writes them to the file, and `cat` prints them, so neither the file nor
# stdout is transformed by shell capture.
request=(curl --silent --show-error --fail --max-time 300 "$API_URL" \
    --header "Authorization: Bearer $GROQ_API_KEY")
request+=("${form[@]}")

if [ -n "$session_dir" ]; then
    "${request[@]}" --output "$session_dir/transcript.raw.json"
    cat "$session_dir/transcript.raw.json"
else
    "${request[@]}"
fi
