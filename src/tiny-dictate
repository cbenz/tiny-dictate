#!/usr/bin/env bash

STATE_DIR="${XDG_RUNTIME_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}}/tiny-dictate"
# One directory per dictation. It *is* the claim on the microphone: creating it
# with mkdir is atomic, so two dictations can never run at once.
SESSION_DIR="$STATE_DIR/session"
SESSION_PIDFILE="$SESSION_DIR/session.pid"
RECORDER_PIDFILE="$SESSION_DIR/arecord.pid"
ENCODER_PIDFILE="$SESSION_DIR/lame.pid"
PRESENTER_STATE_FILE="$SESSION_DIR/state"
AUDIO_FILE="$SESSION_DIR/audio.mp3"
AUDIO_FIFO="$SESSION_DIR/audio.fifo"
AUDIO_ERROR_FILE="$SESSION_DIR/arecord.err"
TRANSCRIBE_ERROR_FILE="$SESSION_DIR/transcribe.err"
COMMAND_LOCK_DIR="$STATE_DIR/command.lock"

mkdir -p "$STATE_DIR"

require_commands() {
    local missing=()
    local cmd

    for cmd in "$@"; do
        if ! command -v "$cmd" >/dev/null 2>&1; then
            missing+=("$cmd")
        fi
    done

    if [ "${#missing[@]}" -gt 0 ]; then
        printf 'Missing dependencies: %s\n' "${missing[*]}" >&2
        return 1
    fi
}

format_error_message() {
    local error_text="$1"
    local single_line

    single_line="$(printf '%s' "$error_text" | tr '\n' ' ' | sed -E 's/[[:space:]]+/ /g; s/^ //; s/ $//')"
    if [ -z "$single_line" ]; then
        printf 'Unknown error'
        return
    fi

    printf '%.180s' "$single_line"
}

# ── presentation ─────────────────────────────────────────────
# Two channels, one job each:
#   - the live state (recording, transcribing) and the cancelled verdict are drawn by the
#     presenter, the only thing on screen while a dictation runs
#   - failures are desktop notifications, sent once: nothing has to replace them, so there
#     is no notification id to track
NOTIFY_APP_NAME="tiny-dictate"

# How long a verdict stays on screen before the session takes the pill down. It is the
# timeout the cancellation notification used to have.
VERDICT_SECONDS=1
notify_event() {
    local message="$1"
    local timeout="${2:-6000}"
    local urgency="${3:-normal}"

    notify-send --app-name="$NOTIFY_APP_NAME" --urgency="$urgency" \
        --expire-time="$timeout" "$NOTIFY_APP_NAME" "$message" >/dev/null 2>&1 || true
}

# The command that draws the live state. Like the transcription command it is resolved
# with `command -v`, and it is given the state file and the pid it must outlive.
resolve_presenter() {
    command -v "${TINY_DICTATE_PRESENT:-tiny-dictate-present}" 2>/dev/null
}

# A reader must never see half a state: a truncating write is not atomic, `mv` is.
write_presenter_state() {
    local temporary="$PRESENTER_STATE_FILE.$$"

    printf '%s\n' "$1" > "$temporary" && mv "$temporary" "$PRESENTER_STATE_FILE"
}

# A verdict written by `cancel` owns the screen. The session reads it off the state file
# rather than waiting for a signal, so it can arrive at any moment and is never missed.
cancelled() {
    [ "$(cat "$PRESENTER_STATE_FILE" 2>/dev/null)" = "cancelled" ]
}

# Show the verdict for as long as a notification of it used to stay on screen. The pill is
# already drawing it: this is the dwell, before the session takes it down.
show_verdict() {
    kill_from_pidfile "$ENCODER_PIDFILE" -TERM
    sleep "$VERDICT_SECONDS"
    stop_presenter
}

# One presenter per dictation, never replaced: changing state is a write to the file it
# watches. The session is the only writer of that file, so the presenter is the only writer
# of the screen, and no frame of it can land after it is gone.
start_presenter() {
    write_presenter_state "$1"
    "$PRESENTER" "$PRESENTER_STATE_FILE" "$BASHPID" &
    PRESENTER_PID=$!
}

# Bounded, like every wait here: a wedged process must not hold the session hostage, and
# SIGKILL always works. The presenter also leaves on its own when the state file or the
# session that owns it disappears.
stop_presenter() {
    local pid="${PRESENTER_PID:-}"
    local i

    [ -n "$pid" ] || return 0

    write_presenter_state stop 2>/dev/null || true
    for i in {1..40}; do
        kill -0 "$pid" 2>/dev/null || break
        sleep 0.05
    done
    kill -KILL "$pid" 2>/dev/null || true

    PRESENTER_PID=""
}

detect_clipboard_tool() {
    if command -v wl-copy >/dev/null 2>&1 && command -v wl-paste >/dev/null 2>&1; then
        CLIPBOARD_TOOL="wl-clipboard"
        return 0
    fi
    return 1
}

clipboard_write_clipboard() {
    local value="$1"
    printf '%s' "$value" | wl-copy
}

clipboard_write_primary() {
    local value="$1"
    printf '%s' "$value" | wl-copy --primary
}

clipboard_write_both() {
    local value="$1"
    clipboard_write_clipboard "$value"
    clipboard_write_primary "$value"
}

clipboard_paste_via_shift_insert() {
    local value="$1"
    local hold_delay="${LLM_SHIFT_INSERT_HOLD_DELAY_SEC:-0.04}"
    local key_status=0

    clipboard_write_both "$value"

    # ydotool uses Linux input keycodes: 42=LeftShift, 110=Insert.
    ydotool key 42:1 || return 1
    sleep "$hold_delay"
    ydotool key 110:1 110:0 || key_status=$?
    sleep "$hold_delay"
    ydotool key 42:0 || true

    return "$key_status"
}

release_command_lock() {
    rm -rf "$COMMAND_LOCK_DIR"
}

acquire_command_lock() {
    local owner_pid

    if mkdir "$COMMAND_LOCK_DIR" 2>/dev/null; then
        printf '%s' "$$" > "$COMMAND_LOCK_DIR/pid"
        trap release_command_lock EXIT
        return 0
    fi

    if [ -f "$COMMAND_LOCK_DIR/pid" ]; then
        owner_pid="$(cat "$COMMAND_LOCK_DIR/pid" 2>/dev/null || true)"
        if [ -n "$owner_pid" ] && ! kill -0 "$owner_pid" 2>/dev/null; then
            rm -rf "$COMMAND_LOCK_DIR"
            if mkdir "$COMMAND_LOCK_DIR" 2>/dev/null; then
                printf '%s' "$$" > "$COMMAND_LOCK_DIR/pid"
                trap release_command_lock EXIT
                return 0
            fi
        fi
    fi

    return 1
}

# Query only: nothing is modified here, so a query cannot perturb a live session.
is_running_pidfile() {
    local pid

    pid="$(cat "$1" 2>/dev/null)" || return 1
    [ -n "$pid" ] || return 1
    kill -0 "$pid" 2>/dev/null
}

recording_active() {
    is_running_pidfile "$RECORDER_PIDFILE"
}

session_active() {
    is_running_pidfile "$SESSION_PIDFILE"
}

# Send a signal to the process recorded in a pidfile. The pidfile is deliberately NOT
# removed: the session uses it to tell whether the recorder is still alive, so deleting
# it here would make the session believe that recording is over.
kill_from_pidfile() {
    local pidfile="$1"
    local signal="$2"

    if is_running_pidfile "$pidfile"; then
        kill "$signal" "$(cat "$pidfile")" 2>/dev/null
    fi
}

# Create the session directory. mkdir is the atomic claim: it fails when a session
# already exists, whether it is live or stale.
claim_session() {
    mkdir "$SESSION_DIR" 2>/dev/null && return 0

    # A stale directory (session killed by a signal, crash…) can be reclaimed, but
    # never while a session or a recorder process is still alive.
    if session_active || recording_active; then
        return 1
    fi

    rm -rf "$SESSION_DIR"
    mkdir "$SESSION_DIR" 2>/dev/null
}

microphone_is_muted() {
    local output
    local control

    if command -v wpctl >/dev/null 2>&1; then
        output="$(wpctl get-volume @DEFAULT_AUDIO_SOURCE@ 2>/dev/null || true)"
        if [ -n "$output" ]; then
            printf '%s' "$output" | grep -q '\[MUTED\]' && return 0
            return 1
        fi
    fi

    if command -v pactl >/dev/null 2>&1; then
        output="$(pactl get-source-mute @DEFAULT_SOURCE@ 2>/dev/null || true)"
        case "$output" in
            *"Mute: yes"*) return 0 ;;
            *"Mute: no"*) return 1 ;;
        esac
    fi

    if command -v amixer >/dev/null 2>&1; then
        for control in Capture Mic; do
            output="$(amixer -D default sget "$control" 2>/dev/null || true)"
            if [ -n "$output" ]; then
                printf '%s' "$output" | grep -q '\[on\]' && return 1
                printf '%s' "$output" | grep -q '\[off\]' && return 0
            fi
        done
    fi

    return 1
}

ensure_micro_not_muted() {
    if microphone_is_muted; then
        notify_event "🎙️ Microphone is muted. Unmute it before dictating." 4500 critical
        return 1
    fi

    return 0
}

# The transcription command is provided by the user: it receives the audio file as $1 and
# prints the transcribed text on stdout. $TINY_DICTATE_TRANSCRIBE wins, otherwise the
# reference implementation is looked up on PATH. Prints the resolved path, or nothing.
resolve_transcribe_command() {
    command -v "${TINY_DICTATE_TRANSCRIBE:-tiny-dictate-transcribe}" 2>/dev/null
}

# The session process owns the whole dictation lifecycle: it outlives the `start`
# command that forked it and it is the only process driving the presenter.
session() {
    local transcript
    local transcribe_command
    local error_message
    local recording_failed=0
    local encoder_failed=0

    # This runs in a subshell: do not inherit the caller's EXIT trap.
    trap - EXIT
    trap session_cleanup EXIT

    # $BASHPID, not $$: inside a subshell $$ still expands to the pid of the
    # `tiny-dictate start` process, which exits right after forking us. The presenter
    # watches that pid: it is how it knows to leave if we are killed.
    start_presenter recording

    # Wait for the recorder, which our parent started and recorded before forking us.
    # If the encoder dies first, the recorder writes into a pipe nobody reads and
    # would block forever: give up instead of spinning forever.
    while is_running_pidfile "$RECORDER_PIDFILE"; do
        if ! is_running_pidfile "$ENCODER_PIDFILE"; then
            recording_failed=1
            break
        fi
        sleep 0.1
    done

    # The encoder exits once the recorder is gone and it has flushed its last frames.
    # Bounded: lame blocks in open() until arecord opens the pipe, so never wait for it
    # forever. When nothing was captured there is nothing to flush, and the encoder can be
    # blocked in open() for good, so do not wait for it at all.
    if [ -s "$AUDIO_FILE" ]; then
        for _ in {1..100}; do
            is_running_pidfile "$ENCODER_PIDFILE" || break
            sleep 0.05
        done

        if is_running_pidfile "$ENCODER_PIDFILE"; then
            recording_failed=1
            encoder_failed=1
        fi
    else
        recording_failed=1
    fi

    # `cancel` writes its verdict into the state file: it owns the last word, so a cancelled
    # dictation is neither a failure nor something to transcribe.
    if cancelled; then
        show_verdict
        return 0
    fi

    if [ "$recording_failed" -eq 1 ]; then
        kill_from_pidfile "$RECORDER_PIDFILE" -INT
        kill_from_pidfile "$ENCODER_PIDFILE" -TERM
        if [ "$encoder_failed" -eq 1 ]; then
            error_message="the audio encoder did not finish"
        elif [ -s "$AUDIO_FILE" ]; then
            error_message="the audio encoder stopped while recording"
        else
            error_message="no audio was captured"
        fi
        if [ -s "$AUDIO_ERROR_FILE" ]; then
            error_message="$error_message ($(format_error_message "$(cat "$AUDIO_ERROR_FILE" 2>/dev/null)"))"
        fi
        # The pill goes before the notification: one thing on screen at a time.
        stop_presenter
        notify_event "❌ Recording failed: $error_message" 6000
        return 0
    fi

    write_presenter_state transcribing

    transcribe_command="$(resolve_transcribe_command)"
    if transcript="$("$transcribe_command" "$AUDIO_FILE" 2>"$TRANSCRIBE_ERROR_FILE")"; then
        # A cancel that landed while the transcription was running: the text is dropped
        # rather than pasted behind the user's back.
        if cancelled; then
            show_verdict
            return 0
        fi
        # The live state is over once there is text: the pill has nothing left to say,
        # and what may follow is a terminal event.
        stop_presenter
        if [ -n "$transcript" ]; then
            if ! clipboard_paste_via_shift_insert "$transcript"; then
                notify_event "❌ Could not paste the transcription" 6000 critical
            fi
        fi
    else
        stop_presenter
        error_message="$(format_error_message "$(cat "$TRANSCRIBE_ERROR_FILE" 2>/dev/null)")"
        notify_event "❌ Transcription failed: $error_message" 6000
    fi
}

# Remove what this session owns, and nothing else: a newer session could have reclaimed the
# same paths in the meantime (the directory is the microphone claim, so this only happens
# when a session died without cleaning up), and its files and its presenter are not ours.
session_cleanup() {
    if [ "$(cat "$SESSION_PIDFILE" 2>/dev/null)" != "$BASHPID" ]; then
        return 0
    fi

    stop_presenter
    rm -rf "$SESSION_DIR"
}

start() {
    local recorder_pid
    local encoder_pid

    if [ -z "$(resolve_transcribe_command)" ]; then
        printf 'No transcription command: set TINY_DICTATE_TRANSCRIBE or install tiny-dictate-transcribe\n' >&2
        notify_event "❌ No transcription command. Set TINY_DICTATE_TRANSCRIBE or install tiny-dictate-transcribe" 8000 critical
        return 1
    fi

    if [ -z "$PRESENTER" ]; then
        printf 'No presenter: set TINY_DICTATE_PRESENT or install tiny-dictate-present\n' >&2
        notify_event "❌ No presenter. Set TINY_DICTATE_PRESENT or install tiny-dictate-present" 8000 critical
        return 1
    fi

    if ! claim_session; then
        # A session is running: its pill already shows what is going on, and it is the
        # only writer of the screen.
        printf 'tiny-dictate is already busy\n' >&2
        return 1
    fi

    if ! ensure_micro_not_muted; then
        rm -rf "$SESSION_DIR"
        return 1
    fi

    if ! mkfifo "$AUDIO_FIFO"; then
        rm -rf "$SESSION_DIR"
        notify_event "❌ Cannot create the audio pipe" 6000
        return 1
    fi

    # lame opens the pipe for reading, arecord for writing. Both PIDs are recorded
    # here, synchronously, *before* the session process is forked: that is what makes
    # the wait in `session` race-free.
    lame -r -s 16 --bitwidth 16 --signed --little-endian -m m -b 64 -S - "$AUDIO_FILE" \
        < "$AUDIO_FIFO" &
    encoder_pid=$!
    printf '%s' "$encoder_pid" > "$ENCODER_PIDFILE"

    arecord -f S16_LE -r 16000 -c 1 -t raw > "$AUDIO_FIFO" 2>"$AUDIO_ERROR_FILE" &
    recorder_pid=$!
    printf '%s' "$recorder_pid" > "$RECORDER_PIDFILE"

    session &
    printf '%s' "$!" > "$SESSION_PIDFILE"
}

stop() {
    if recording_active; then
        kill_from_pidfile "$RECORDER_PIDFILE" -INT
    elif session_active; then
        # No notification here: the session's pill already shows "Transcribing", and it
        # is the only writer of the screen.
        printf 'Transcription already in progress\n' >&2
    fi
}

cancel() {
    if ! recording_active && ! session_active; then
        echo "No recording in progress"
        return 0
    fi

    # A verdict is a state like any other: writing it is what shows it, so it is written
    # before anything is signalled. The session reads it and reports it rather than the
    # failure of a recording that was cut short.
    write_presenter_state cancelled 2>/dev/null || true

    # Stop the recorder, never the encoder: the encoder outlives it to flush the last frames.
    kill_from_pidfile "$RECORDER_PIDFILE" -INT

    if session_active; then
        # And never the session either: it is the one showing the verdict, taking the pill
        # down once the dwell is over, and removing its own directory.
        return 0
    fi

    # No session left to do any of that: only its leftovers are here.
    kill_from_pidfile "$ENCODER_PIDFILE" -TERM
    rm -rf "$SESSION_DIR"
}

toggle() {
    if recording_active; then
        stop
    elif session_active; then
        printf 'Transcription already in progress\n' >&2
    else
        start
    fi
}

status() {
    if recording_active || session_active; then
        echo "working"
    else
        echo "idle"
    fi
}

usage() {
    cat <<'EOF'
Usage: tiny-dictate <command>

Commands:
  start   Start recording
  stop    Stop recording and transcribe
  cancel  Cancel recording
  toggle  Start if idle, stop if recording
  status  Show status (idle or working)
EOF
}

PRESENTER="$(resolve_presenter)"

if ! require_commands arecord lame ydotool notify-send curl; then
    notify_event "❌ Missing dependencies" 6000
    printf 'Install the missing commands and retry.\n' >&2
    exit 1
fi

if ! detect_clipboard_tool; then
    printf 'Missing dependencies: wl-copy and wl-paste\n' >&2
    notify_event "❌ Missing dependencies: wl-copy and wl-paste" 6000
    printf 'Install wl-clipboard and retry.\n' >&2
    exit 1
fi

command=""

while [ "$#" -gt 0 ]; do
    case "$1" in
        start|stop|cancel|toggle|status)
            if [ -n "$command" ]; then
                echo "Only one command can be provided" >&2
                exit 1
            fi
            command="$1"
            ;;
        -h|--help|help)
            command="help"
            ;;
        *)
            echo "Unknown argument: $1" >&2
            usage
            exit 1
            ;;
    esac
    shift
done

case "$command" in
    start|stop|cancel|toggle)
        if ! acquire_command_lock; then
            notify_event "⏳ tiny-dictate is already handling another command" 1200
            exit 1
        fi
        ;;
esac

case "$command" in
    start)
        start
        ;;
    stop)
        stop
        ;;
    cancel)
        cancel
        ;;
    toggle)
        toggle
        ;;
    status)
        status
        ;;
    ""|help)
        usage
        ;;
    *)
        usage
        exit 1
        ;;
esac
